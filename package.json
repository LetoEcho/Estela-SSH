{
  "name": "estela-ssh",
  "version": "0.1.0",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "ng build && node esbuild.mjs",
    "start": "electron .",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.node.json && tsc -p tsconfig.app.json --noEmit",
    "dist:linux": "npm run build && electron-builder --linux",
    "dist:win": "npm run build && electron-builder --win --x64",
    "test-server": "esbuild test/real-server.ts --bundle --platform=node --external:ssh2 --log-level=warning --outfile=dist/test-server.js && node dist/test-server.js"
  },
  "private": true,
  "packageManager": "npm@11.19.0",
  "dependencies": {
    "node-pty": "^1.1.0",
    "serialport": "^13.0.0",
    "ssh2": "^1.17.0"
  },
  "devDependencies": {
    "@angular/build": "^22.2.3",
    "@angular/cdk": "^22.2.3",
    "@angular/cli": "^22.2.3",
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/compiler-cli": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/forms": "^22.2.0",
    "@angular/platform-browser": "^22.2.0",
    "@types/node": "^26.6.5",
    "@types/ssh2": "^1.15.6",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/addon-unicode11": "^0.9.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "electron": "^44.9.1",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "monaco-editor": "^0.57.0",
    "prettier": "^3.8.1",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "typescript": "~6.0.2",
    "vitest": "^5.0.5"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "electron-winstaller@5.4.0": true,
    "cpu-features": false,
    "ssh2": false,
    "@parcel/watcher": false,
    "lmdb": false,
    "msgpackr-extract": false,
    "node-pty@1.1.0": true,
    "@serialport/bindings-cpp@13.0.0": false
  },
  "description": "SSH and RDP desktop client",
  "author": "LetoEcho <172483139+LetoEcho@users.noreply.github.com>",
  "main": "dist/main/main.js",
  "homepage": "https://github.com/LetoEcho/Estela-SSH"
}
